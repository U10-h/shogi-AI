+bool Board::has_legal_king_move() const {
+    const Color us=pos.side_to_move();const Square from=pos.king_square(us);
+    auto targets=kingEffect(from)&~pos.pieces(us);
+    while(targets)if(pos.legal(make_move(from,targets.pop(),us,KING)))return true;
+    return false;
+}
+
+bool Board::has_legal_move() const {
+    if(pos.in_check())return !legal_moves().empty();
+    if(has_legal_king_move())return true;
+    // The generator handles mandatory promotion, nifu and pawn-drop mate.
+    // Only one legal witness is needed, not the complete filtered list.
+    for(auto entry:MoveList<NON_EVASIONS_ALL>(pos))if(pos.legal(entry.move))return true;
+    return false;
