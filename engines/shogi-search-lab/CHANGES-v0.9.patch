+std::vector<Move> Board::tactical_moves() const {
+    // Do not use CAPTURES_PRO_PLUS: it omits quiet non-pawn promotions.
+    // The qsearch leaf policy includes ALL promotions and legal non-promotions.
+    if(pos.in_check())return legal_moves();
+    std::vector<Move> moves;
+    const Color us=pos.side_to_move();
+    const auto occupied=pos.pieces(), enemy=pos.pieces(~us), empty=pos.empties();
+    auto pieces=pos.pieces(us);
+    while(pieces) {
+        const Square from=pieces.pop();const Piece pc=pos.piece_on(from);
+        const PieceType pt=type_of(pc);
+        const bool promotable=pt>=PAWN&&pt<=ROOK;
+        auto target=enemy;
+        if(promotable)target|=canPromote(us,from)?empty:(empty&enemy_field(us));
+        auto dest=effects_from(pc,from,occupied)&target;
+        while(dest) {
+            const Square to=dest.pop();
+            if(promotable&&canPromote(us,from,to)) {
+                const Move m=make_move_promote(from,to,pc);
+                if(pos.legal(m))moves.push_back(m);
+            }
+            const int rank=us==BLACK?int(rank_of(to)):8-int(rank_of(to));
+            const bool mandatory=((pt==PAWN||pt==LANCE)&&rank==0)||(pt==KNIGHT&&rank<=1);
+            if(pos.piece_on(to)!=NO_PIECE&&!mandatory) {
+                const Move m=make_move(from,to,pc);
+                if(pos.legal(m))moves.push_back(m);
+            }
+        }
+    }
+    return moves;
+}
